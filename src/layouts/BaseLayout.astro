---
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description, lang = 'ru' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <slot />
  </body>
</html>
