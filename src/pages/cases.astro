---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BrandMark } from '@/components/ui/BrandMark';
import { ArrowIcon } from '@/components/ui/ArrowIcon';
import FinalCta from '@/components/sections/FinalCta.astro';
import SiteFooter from '@/components/sections/SiteFooter.astro';
import {
  caseCategories,
  caseHref,
  cases,
  navigation,
  navHref,
} from '@/data/landing';

const pathname = Astro.url.pathname;
---

<BaseLayout
  title="Кейсы — Deep"
  description="Проекты Deep: HR и внутриком, лояльность, мероприятия, спецпроекты и трейд-маркетинг."
>
  <main class="cases-page">
    <header class="cases-page__bar">
      <a class="cases-page__brand" href="/" aria-label="Deep — на главную">
        <BrandMark />
      </a>
      <nav class="cases-page__nav" aria-label="Основная навигация">
        {
          navigation.map(([label, href]) => (
            <a href={navHref(href, pathname)}>{label}</a>
          ))
        }
      </nav>
      <a class="brief-button" href="/#configurator" data-open-contact
        >Обсудить проект</a
      >
    </header>
    <section class="cases-page__intro section-shell" data-reveal>
      <a class="cases-page__back" href="/">
        <ArrowIcon direction="left" />
        <span>На главную</span>
      </a>
      <h1 class="section-title">Все <span>кейсы</span></h1>
      <p class="section-lead">
        Примеры проектов на платформенной базе Deep. Механика, сценарий и
        интеграции каждый раз собираются под задачу клиента.
      </p>
    </section>
    <section class="cases-page__grid section-shell" aria-label="Список кейсов">
      {
        cases.map((item) => {
          const category =
            caseCategories.find((entry) => entry.id === item.categoryId)
              ?.title ?? item.categoryId;
          return (
            <article
              class={`cases-card cases-card--${item.artwork} cases-card--brand`}
              data-brand={item.theme}
              data-reveal
            >
              <div class="cases-card__art" aria-hidden="true">
                <img
                  src={item.cover}
                  alt=""
                  width="1536"
                  height="1024"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="cases-card__body">
                <p class="cases-card__kind">{category}</p>
                <h2>
                  <a class="cases-card__link" href={caseHref(item.id)}>
                    {item.brand}
                    {item.brandNote && ' '}
                    {item.brandNote && (
                      <small class="cases-card__note">({item.brandNote})</small>
                    )}
                    {' — '}
                    {item.title}
                  </a>
                </h2>
                <p class="cases-card__text">{item.description}</p>
                <ul class="cases-card__tags" role="list">
                  {item.mechanics.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                <span class="cases-card__more" aria-hidden="true">
                  Смотреть кейс
                  <ArrowIcon direction="right" />
                </span>
              </div>
            </article>
          );
        })
      }
    </section>
    <FinalCta configuratorHref="/#configurator" />
  </main>
  <SiteFooter pathname={pathname} />
</BaseLayout>
