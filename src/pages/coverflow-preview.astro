---
import '@/styles/main.css';
import { HeroCarousel } from '@/components/sections/HeroCarousel';
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hero carousel preview</title>
    <style>
      html,
      body {
        margin: 0;
        min-height: 100%;
        background: #0f0f10;
      }
      .preview {
        max-width: 1512px;
        margin: 0 auto;
        padding: 24px 0;
      }
    </style>
  </head>
  <body>
    <div class="preview">
      <HeroCarousel client:load />
    </div>
  </body>
</html>
