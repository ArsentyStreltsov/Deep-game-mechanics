---
import '@/styles/main.css';
import { HeroCarousel } from '@/components/sections/HeroCarousel';
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Coverflow preview 2048×567</title>
    <style>
      html,
      body {
        margin: 0;
        min-height: 100%;
        background: #0a172c;
      }
      .preview {
        position: relative;
        width: 2048px;
        height: 567px;
        margin: 0;
        overflow: hidden;
      }
      .preview :global(.coverflow) {
        position: relative;
        left: auto;
        right: auto;
        bottom: auto;
        width: 2048px !important;
        height: 567px !important;
      }
      .preview :global(.coverflow__scene) {
        transform: none !important;
      }
    </style>
  </head>
  <body>
    <div class="preview">
      <HeroCarousel client:load />
    </div>
  </body>
</html>
